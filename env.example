# Database (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scholarlink
# Optional direct connection URL for migrations
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/scholarlink

# Auth (JWT)
# Use a strong random string for production
JWT_SECRET=change_this_to_a_strong_secret
# Token expiry format examples: 1h, 7d, 30d
TOKEN_EXPIRY=7d

# Email (Resend)
# Get an API key from Resend dashboard
RESEND_API_KEY=your_resend_api_key
# Verified sender domain/address in Resend
RESEND_EMAIL_FROM="ScholarLink <onboarding@resend.dev>"
